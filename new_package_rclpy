#!/usr/bin/env python3

import sys
from robotdevenv.components_tools import create_package_rclpy

def main():
    # Check if exactly two arguments are provided
    if len(sys.argv) != 3:
        print("Error: You must provide exactly two arguments")
        print("Usage: python3 new_package_rclpy <group_name> <package_name>")
        sys.exit(1)

    # Get the group and package names
    group_name = sys.argv[1]
    package_name = sys.argv[2]

    try:
        create_package_rclpy(group_name, package_name)
        print(f"Package '{package_name}' successfully created in group '{group_name}'")
    except ValueError as e:
        print(f"Error: {str(e)}")
        sys.exit(1)
    except FileNotFoundError as e:
        print(f"Error: {str(e)}")
        sys.exit(1)
    except Exception as e:
        print(f"Error creating package: {str(e)}")
        sys.exit(1)

if __name__ == "__main__":
    main()
